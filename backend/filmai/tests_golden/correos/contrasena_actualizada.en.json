ackground-color: #e67e22;\n                    color: #ffffff;\n                    text-decoration: none;\n                    font-weight: bold;\n                    font-size: 15px;\n                    padding: 12px 32px;\n                    border-radius: 10px;\n                  \"\n                  >Recover my account</a\n                >\n              </td>\n            </tr>\n            <tr>\n              <td\n                align=\"center\"\n                style=\"\n                  padding: 0 40px 24px 40px;\n                  font-size: 13px;\n                  line-height: 1.6;\n                  color: #777777;\n                \"\n              >\n                If the button doesn’t work, copy and paste this link into your\n                browser:<br />\n                <a\n                  href=\"https://frontend.filmai.test/login/\"\n                  style=\"color: #f5c518; word-break: break-all\"\n                  >https://frontend.filmai.test/login/</a\n                >\n              </td>\n            </tr>\n            <tr>\n              <td\n                style=\"\n                  padding: 16px 40px 8px 40px;\n                  border-top: 1px solid #2a2a45;\n                  font-size: 13px;\n                  line-height: 1.6;\n                  color: #777777;\n                \"\n              >\n                If you didn’t make this change, recover your account from the log in screen with “Forgot your password?” and choose a new password.\n              </td>\n            </tr>\n            <tr>\n              <td\n                style=\"\n                  padding: 16px 40px 40px 40px;\n                  font-size: 13px;\n                  color: #777777;\n                \"\n              >\n                The FilmAI team\n              </td>\n            </tr>\n          </table>\n        </td>\n      </tr>\n    </table>\n  </body>\n</html>\n"
