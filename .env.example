# PostgreSQL — Base de datos
POSTGRES_DB=filmai_dev
POSTGRES_USER=filmai_user
POSTGRES_PASSWORD=<completar>

# Django — Backend
# Generar SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<completar>
DEBUG=True                                                                   # [fijo] True en desarrollo, False en producción
ALLOWED_HOSTS=localhost,127.0.0.1,backend                                    # [fijo]
CORS_ALLOWED_ORIGINS=http://localhost:3000                                   # [fijo] el frontend en dev

# Django Admin — Superuser inicial
# El entrypoint crea automáticamente este superuser si no existe.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@filmai.com
DJANGO_SUPERUSER_PASSWORD=<completar>

# JWT — JSON Web Tokens
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=480                                        # [fijo] 8 horas de sesión
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7                                            # [fijo]
JWT_AUTH_SECURE=False                                                        # Desarrollo: False (HTTP local). Producción: True (HTTPS obligatorio)

# Google OAuth 2.0
# Obtener credenciales en: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada: http://localhost:8000/api/auth/google/callback/
GOOGLE_CLIENT_ID=<completar>
GOOGLE_CLIENT_SECRET=<completar>

# TMDB API — Catálogo de películas y series
# Obtener API key gratuita en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=<completar>
TMDB_API_BASE_URL=https://api.themoviedb.org/3                               # [fijo]
TMDB_TIMEOUT=5                                                               # [fijo]

# LLM — Chatbot de recomendaciones
# La clave es lo único obligatorio. Lo demás tiene valor por defecto en settings.py.
LLM_API_KEY=<completar>
# LLM_PROVIDER=openai_compatible                                             # formato de la API, no la empresa
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_THINKING=False
# Tiempo máximo de un turno del chat, en segundos (modelo y tools incluidos).
# LLM_TIMEOUT_SECONDS=25
# TMDB dentro del chat: timeout (s) y reintentos, más cortos que los generales.
# CHAT_TMDB_TIMEOUT=3
# CHAT_TMDB_REINTENTOS=1
# Minutos de silencio que cortan una sesión del chat: al modelo solo le llega el
# historial desde el último hueco mayor a esto.
# CHAT_VENTANA_SESION_MINUTOS=45
# Mensajes por usuario y por hora; el siguiente recibe 429 (Too Many Requests).
# CHAT_MENSAJES_POR_HORA=20

# Ollama — Vectores de la búsqueda semántica (bge-m3)
# Por defecto, el puente al Ollama de Windows (perfil `ollama-windows`).
# Con el perfil `ollama` (contenedor): OLLAMA_URL=http://ollama:11434
# Con Docker Desktop no hace falta el puente, porque llega directo al Ollama de
# Windows: OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=http://host.docker.internal:11435                                 # [fijo]
# Cuánto queda el modelo en memoria sin usarse. En un servidor: -1m (nunca se descarga).
OLLAMA_KEEP_ALIVE=30m                                                        # [fijo]

# Email — Envío de correos
# Opción A — Desarrollo sin envío real: los emails se imprimen en la terminal.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@filmai.com
#
# Opción B — Resend (emails reales a tu bandeja):
# Sin dominio propio verificado, Resend solo permite enviar desde
# onboarding@resend.dev y al email dueño de la cuenta.
# RESEND_TEST_RECIPIENT redirige TODOS los emails salientes a esa dirección.
EMAIL_BACKEND=filmai.email_backends.ResendBackend
RESEND_API_KEY=<completar>
RESEND_TEST_RECIPIENT=<completar>                                           # email dueño de la cuenta Resend
DEFAULT_FROM_EMAIL=FilmAI <onboarding@resend.dev>
#
# Opción C — Resend con Brevo de respaldo (issue #181):
# Resend va primero; si no puede enviar (caída, cuota agotada de 100/día o
# 3000/mes, clave inválida), el mismo correo sale por Brevo (300/día gratis).
# Un correo que Resend aceptó nunca se reenvía. Para activarlo, reemplazá
# EMAIL_BACKEND de la opción B por el de abajo y agregá las variables BREVO_*.
# Marcha atrás: EMAIL_BACKEND=filmai.email_backends.ResendBackend.
# EMAIL_BACKEND=filmai.email_backends.RespaldoBackend
# RESEND_API_KEY=<completar>
# Clave API v3 de Brevo (SMTP y API → Claves API, empieza con xkeysib-).
# BREVO_API_KEY=<completar>
# Remitente de Brevo (Brevo no puede enviar como onboarding@resend.dev). Debe
# ser un remitente único VERIFICADO en Brevo: Configuración → Remitentes,
# dominios e IP dedicadas → Senders → Add a sender, y confirmar el correo que
# llega a esa casilla. Obligatorio en producción mientras DEFAULT_FROM_EMAIL
# sea @resend.dev. Ejemplo (dirección ficticia):
# BREVO_FROM_EMAIL=FilmAI <cuenta@ejemplo.com>
# Solo desarrollo: redirige TODOS los emails enviados por Brevo a esta
# dirección (se rechaza en producción). Ejemplo ficticio:
# BREVO_TEST_RECIPIENT=bandeja@ejemplo.com
# OJO: si en Brevo activaste «Authorised IPs» (Settings → Security), cada
# llamada desde una IP no autorizada responde 401 (Unauthorized) aunque la
# clave sea correcta: autorizá la IP del servidor o desactivá la restricción.

# Redis (exige contraseña: docker-compose.yml la aplica con requirepass)
# IMPORTANTE si ya tenías un .env de antes de la auditoría F1 (20/10/2026):
#   1. Agregá REDIS_PASSWORD (abajo). Sin ella `docker compose up` aborta a propósito.
#   2. BORRÁ (o comentá) las líneas REDIS_URL, CELERY_BROKER_URL y CELERY_RESULT_BACKEND
#      si las tenías: apuntaban a un Redis sin contraseña y pisan las que ahora se
#      arman solas. Con DEBUG=True no hay aviso al arrancar: Celery falla recién al
#      ejecutar una tarea (NOAUTH).
#   3. Recreá los contenedores: docker compose up -d --force-recreate
# Va vacía a propósito: un valor de ejemplo pasaría el chequeo de "falta" y Redis
# arrancaría con una contraseña pública. Generá una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=
# Con REDIS_PASSWORD definida, las URLs se arman solas (DB 0 caché de TMDB, DB 1 y 2 de Celery).
# Solo hace falta definirlas para apuntar a otro Redis, con la contraseña incluida:
# REDIS_URL=redis://:<password>@redis:6379/0
# CELERY_BROKER_URL=redis://:<password>@redis:6379/1
# CELERY_RESULT_BACKEND=redis://:<password>@redis:6379/2

# Proxies de confianza delante de Django (límites por IP; ver REST_FRAMEWORK en settings.py).
# Desarrollo: 0 (o vacío). Producción (DEBUG=False): obligatorio; el arranque falla si falta.
# Con un proxy delante y 0, todos los usuarios comparten la IP del proxy.
NUM_PROXIES=0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000                                    # [fijo]
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<completar>                                     # Mismo GOOGLE_CLIENT_ID

# Base pública usada en los enlaces de confirmación y recuperación
FRONTEND_URL=http://localhost:3000
