# FilmAI — Variables de entorno
# Copiar a .env (cp .env.example .env) y completar los valores marcados <completar>.
# .env NUNCA se commitea (está en .gitignore).

# --- PostgreSQL ---
POSTGRES_DB=filmai_dev
POSTGRES_USER=filmai_user
POSTGRES_PASSWORD=<completar>

# --- Django ---
# Generar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<completar>
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Django Admin (superuser inicial) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@filmai.com
DJANGO_SUPERUSER_PASSWORD=<completar>

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=480
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_AUTH_SECURE=False

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=<completar>
GOOGLE_CLIENT_SECRET=<completar>

# --- TMDB API ---
TMDB_API_KEY=<completar>
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_TIMEOUT=5

# --- LLM ---
LLM_API_KEY=<completar>
LLM_PROVIDER=openai

# --- Email (Resend) ---
# Sin estas vars se usa django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=filmai.email_backends.ResendBackend
RESEND_API_KEY=<completar>
RESEND_TEST_RECIPIENT=<completar>
DEFAULT_FROM_EMAIL=FilmAI <onboarding@resend.dev>

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<completar>
