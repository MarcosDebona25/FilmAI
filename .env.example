# =============================================================================
# FilmAI — Variables de entorno
# =============================================================================
# INSTRUCCIONES:
#   1. Copiar este archivo a .env:  cp .env.example .env
#   2. Completar TODAS las variables marcadas con <completar>
#   3. .env NUNCA se commitea (está en .gitignore)
#   4. Las variables marcadas como [fijo] ya tienen el valor correcto para
#      desarrollo local con Docker. Solo cambiarlas si sabés lo que hacés.
# =============================================================================

# =============================================================================
# PostgreSQL — Base de datos
# =============================================================================
# Estos valores se usan para CREAR la base de datos y el usuario la primera vez
# que el contenedor de PostgreSQL arranca. Si el volumen ya existe, se ignoran.
POSTGRES_DB=filmai_dev
POSTGRES_USER=filmai_user
POSTGRES_PASSWORD=<completar>

# =============================================================================
# Django — Backend
# =============================================================================
# Generar SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<completar>
DEBUG=True                                                                   # [fijo] True en desarrollo, False en producción
ALLOWED_HOSTS=localhost,127.0.0.1,backend                                    # [fijo]
CORS_ALLOWED_ORIGINS=http://localhost:3000                                   # [fijo] el frontend en dev

# =============================================================================
# Django Admin — Superuser inicial
# =============================================================================
# El entrypoint crea automáticamente este superuser si no existe.
# Cambiar la contraseña después del primer login.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@filmai.com
DJANGO_SUPERUSER_PASSWORD=<completar>

# =============================================================================
# JWT — JSON Web Tokens
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=480                                        # [fijo] 8 horas de sesión
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7                                            # [fijo]
JWT_AUTH_SECURE=False                                                        # [fijo] True en producción (HTTPS); False para localhost sin SSL

# =============================================================================
# Google OAuth 2.0
# =============================================================================
# Obtener credenciales en: https://console.cloud.google.com/apis/credentials
# Crear un proyecto, habilitar "Google+ API" (People API), generar OAuth 2.0 Client ID.
# Redirect URI autorizada: http://localhost:8000/api/auth/google/callback/
GOOGLE_CLIENT_ID=<completar>
GOOGLE_CLIENT_SECRET=<completar>

# =============================================================================
# TMDB API — Catálogo de películas y series
# =============================================================================
# Obtener API key gratuita en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=<completar>
TMDB_API_BASE_URL=https://api.themoviedb.org/3                               # [fijo]

# =============================================================================
# LLM — Chatbot de recomendaciones
# =============================================================================
# Proveedor: openai | anthropic | groq
# Obtener API key en la plataforma correspondiente.
LLM_API_KEY=<completar>
LLM_PROVIDER=openai                                                          # [fijo] cambiar si usás otro proveedor

# =============================================================================
# Email — Envío de correos
# =============================================================================
# Opción A — Desarrollo sin envío real (default): console backend.
#   Los emails se imprimen en la terminal del contenedor backend:
#     docker compose logs -f backend
#
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@filmai.com
#
# Opción B — Resend (emails reales a tu bandeja):
#   1. Crear API key en https://resend.com/api-keys
#   2. SIN dominio propio verificado, Resend solo permite enviar desde
#      onboarding@resend.dev y SOLO al email dueño de la cuenta. Por eso
#      RESEND_TEST_RECIPIENT redirige TODOS los emails salientes a esa
#      dirección (la confirmación de cuenta de cualquier registro llega a tu
#      bandeja y el link sigue siendo válido para la cuenta registrada).
#   3. Con dominio propio verificado: cambiar DEFAULT_FROM_EMAIL a ese dominio,
#      borrar RESEND_TEST_RECIPIENT y enviar a destinatarios reales.
EMAIL_BACKEND=filmai.email_backends.ResendBackend
RESEND_API_KEY=<completar>
RESEND_TEST_RECIPIENT=<completar>                                           # email dueño de la cuenta Resend
DEFAULT_FROM_EMAIL=FilmAI <onboarding@resend.dev>

# =============================================================================
# Redis — Caché y cola de tareas
# =============================================================================
REDIS_URL=redis://redis:6379/0                                               # [fijo] "redis" es el nombre del servicio en docker-compose

# =============================================================================
# Frontend — Next.js
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000                                    # [fijo] URL del backend desde el navegador
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<completar>                                     # Mismo GOOGLE_CLIENT_ID; expuesto al navegador para Google Identity Services
