# PostgreSQL — Base de datos
POSTGRES_DB=filmai_dev
POSTGRES_USER=filmai_user
POSTGRES_PASSWORD=<completar>

# Django — Backend
# Generar SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<completar>
DEBUG=True                                                                   # [fijo] True en desarrollo, False en producción
ALLOWED_HOSTS=localhost,127.0.0.1,backend                                    # [fijo]
CORS_ALLOWED_ORIGINS=http://localhost:3000                                   # [fijo] el frontend en dev

# Django Admin — Superuser inicial
# El entrypoint crea automáticamente este superuser si no existe.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@filmai.com
DJANGO_SUPERUSER_PASSWORD=<completar>

# JWT — JSON Web Tokens
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=480                                        # [fijo] 8 horas de sesión
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7                                            # [fijo]
JWT_AUTH_SECURE=False                                                        # Desarrollo: False (HTTP local). Producción: True (HTTPS obligatorio)

# Google OAuth 2.0
# Obtener credenciales en: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada: http://localhost:8000/api/auth/google/callback/
GOOGLE_CLIENT_ID=<completar>
GOOGLE_CLIENT_SECRET=<completar>

# TMDB API — Catálogo de películas y series
# Obtener API key gratuita en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=<completar>
TMDB_API_BASE_URL=https://api.themoviedb.org/3                               # [fijo]
TMDB_TIMEOUT=5                                                               # [fijo]

# LLM — Chatbot de recomendaciones
# Proveedor: openai | anthropic | groq
LLM_API_KEY=<completar>
LLM_PROVIDER=openai                                                          # [fijo] cambiar si usás otro proveedor

# Email — Envío de correos
# Opción A — Desarrollo sin envío real: los emails se imprimen en la terminal.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=noreply@filmai.com
#
# Opción B — Resend (emails reales a tu bandeja):
# Sin dominio propio verificado, Resend solo permite enviar desde
# onboarding@resend.dev y al email dueño de la cuenta.
# RESEND_TEST_RECIPIENT redirige TODOS los emails salientes a esa dirección.
EMAIL_BACKEND=filmai.email_backends.ResendBackend
RESEND_API_KEY=<completar>
RESEND_TEST_RECIPIENT=<completar>                                           # email dueño de la cuenta Resend
DEFAULT_FROM_EMAIL=FilmAI <onboarding@resend.dev>

# Redis
REDIS_URL=redis://redis:6379/0                                               # [fijo] DB 0: caché de TMDB

# Celery (cola de tareas: embeddings, sync)
CELERY_BROKER_URL=redis://redis:6379/1                                       # [fijo] DB 1: separada del caché
CELERY_RESULT_BACKEND=redis://redis:6379/2                                   # [fijo] DB 2: separada del caché

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000                                    # [fijo]
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<completar>                                     # Mismo GOOGLE_CLIENT_ID
